GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000

# Postgres connection string for the kanban data (users/boards/sessions/etc).
# Local Docker Compose already sets this for you (see docker-compose.yml) - only
# set it here if you're running the backend directly with `uv run uvicorn` against
# a local Postgres, or want this .env to point at a hosted database (e.g. a Neon
# project) instead. In production (Render), set DATABASE_URL as a Render env var,
# not in this file.
# DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban
