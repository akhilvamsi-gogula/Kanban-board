GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000

# Reads attached images; set to empty to turn image reading off.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Attachment text per chat message, shared by its files.
AI_ATTACHMENT_MAX_CHARS=10000

# Used when running the backend without Docker; Docker Compose sets its own.
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban
# Local only: the end-to-end tests sign up many accounts from one address.
KANBAN_AUTH_RATE_LIMIT=1000
